    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\n\nif (!row.script_json) {\n  throw new Error('script_json is missing');\n}\n\nif (!row.postCaption) {\n  throw new Error('postCaption is missing');\n}\n\nlet scriptArray;\n\ntry {\n  scriptArray = JSON.parse(row.script_json);\n} catch (e) {\n  throw new Error('script_json is not valid JSON: ' + e.message);\n}\n\nif (!Array.isArray(scriptArray)) {\n  throw new Error('script_json must be a JSON array');\n}\n\nconst cleanedScript = scriptArray.map((item, index) => {\n  if (!item.actor || !item.text) {\n    throw new Error(`Invalid script item at index ${index}`);\n  }\n\n  const actor = String(item.actor).trim();\n  const text = String(item.text).replace(/\\n/g, ' ').trim();\n\n  if (!['S', 'P'].includes(actor)) {\n    throw new Error(`Invalid actor at index ${index}. Actor must be only S or P.`);\n  }\n\n  if (!text) {\n    throw new Error(`Empty text at index ${index}`);\n  }\n\n  return {\n    actor,\n    text,\n    postCaption: row.postCaption,\n    sourceRowId: row.id || '',\n    topic: row.topic || '',\n    row_number: row.row_number,\n  };\n});\n\nreturn [\n  {\n    json: {\n      script: {\n        script: cleanedScript,\n      },\n      postCaption: row.postCaption,\n      sourceRowId: row.id || '',\n      topic: row.topic || '',\n      row_number: row.row_number,\n    },\n  },\n];"
      },
