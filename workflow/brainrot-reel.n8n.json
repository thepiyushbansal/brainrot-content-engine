        "jsCode": "// Randomly pick one background gameplay clip\nconst minecraftClips = [\n  // Your background clips (any public video links, e.g. Cloudinary). One is picked at random per reel.\n  'https://YOUR-CDN/clips/parkour-01.mp4',\n  'https://YOUR-CDN/clips/parkour-02.mp4',\n  'https://YOUR-CDN/clips/parkour-03.mp4',\n];\n\nconst randomClip = minecraftClips[Math.floor(Math.random() * minecraftClips.length)];\nconst scenes = $input.first().json.scenes;\nconst postCaption = $input.first().json.postCaption || '';\nreturn [{\n  json: {\n    scenes: scenes,\n    postCaption: postCaption,\n    backgroundVideoUrl: randomClip,\n    sImageUrl: 'https://YOUR-CDN/characters/s.png',\n    pImageUrl: 'https://YOUR-CDN/characters/p.png'\n  }\n}];"
      },
