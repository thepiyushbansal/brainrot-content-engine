    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = require('path');\nconst os = require('os');\n\nconst items = $input.all();\n\nconst outputDir = path.join(os.homedir(), 'remotion-video', 'public', 'audio');\nconst publicAudioBaseUrl = 'http://127.0.0.1:8080/audio';\n\nfs.mkdirSync(outputDir, { recursive: true });\n\nfunction getWavDuration(buffer, fallbackText) {\n  try {\n    if (!Buffer.isBuffer(buffer) || buffer.length < 44) {\n      return fallbackEstimate(fallbackText);\n    }\n\n    const riff = buffer.toString('ascii', 0, 4);\n    const wave = buffer.toString('ascii', 8, 12);\n\n    if (riff !== 'RIFF' || wave !== 'WAVE') {\n      return fallbackEstimate(fallbackText);\n    }\n\n    const sampleRate = buffer.readUInt32LE(24);\n    const channels = buffer.readUInt16LE(22);\n    const bitsPerSample = buffer.readUInt16LE(34);\n\n    if (!sampleRate || !channels || !bitsPerSample) {\n      return fallbackEstimate(fallbackText);\n    }\n\n    let offset = 36;\n\n    while (offset + 8 <= buffer.length) {\n      const chunkId = buffer.toString('ascii', offset, offset + 4);\n      const chunkSize = buffer.readUInt32LE(offset + 4);\n\n      if (chunkId === 'data') {\n        // Got the real duration from WAV header\n        return chunkSize / (sampleRate * channels * (bitsPerSample / 8));\n      }\n\n      // FIX 1: Handle odd-byte padding (WAV spec requirement)\n      offset += 8 + chunkSize + (chunkSize % 2);\n    }\n\n    return fallbackEstimate(fallbackText);\n  } catch (e) {\n    return fallbackEstimate(fallbackText);\n  }\n}\n\nfunction fallbackEstimate(text) {\n  // FIX 2: More generous estimate (15 chars/sec instead of 13) + 20% buffer\n  return Math.max(2.0, (String(text || '').length / 15) * 1.2);\n}\n\nconst scenes = [];\nconst postCaption = items[0]?.json?.postCaption || '';\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n\n  const binaryKeys = Object.keys(item.binary || {});\n  if (!binaryKeys.includes('data')) {\n    throw new Error(\n      `Item ${i} has no binary property named \"data\". Found: ${binaryKeys.join(', ') || 'none'}`\n    );\n  }\n\n  const actor = item.json.actor || 'unknown';\n  const text = item.json.text || '';\n\n  const safeActor = String(actor).replace(/[^a-zA-Z0-9_-]/g, '');\n  const filename = `${String(i).padStart(3, '0')}_${safeActor}_${Date.now()}.wav`;\n  const filepath = path.join(outputDir, filename);\n\n  const audioBuffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n\n  fs.writeFileSync(filepath, audioBuffer);\n\n  const durationSeconds = getWavDuration(audioBuffer, text);\n\n  // FIX 3: Always add 20 extra frames (0.67 sec) as a safety buffer\n  const durationInFrames = Math.ceil(durationSeconds * 30) + 5;\n\n  scenes.push({\n    actor,\n    text,\n    audioUrl: `${publicAudioBaseUrl}/${filename}`,\n    durationInFrames,\n  });\n}\n\nreturn [{ json: { scenes, postCaption } }];"
      },
